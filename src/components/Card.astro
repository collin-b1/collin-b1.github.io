---
interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<section class="card">
  <h2>{title}</h2>
  <p><slot name="description" /></p>
  <div class="media">
    <slot name="media" />
  </div>
  <slot name="footer" />
</section>

<style lang="scss">
  .card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    background-color: var(--color-fg);
    padding: 1rem 1.5rem;

    > *:not(:last-child) {
      margin-bottom: 0.5rem;
    }

    > h2 {
      font-size: 1.25rem;

      &:not(:first-child) {
        margin-top: 1.5rem;
      }
    }

    > p {
      color: var(--color-text-secondary);
      flex: 1;
      text-align: justify;
      text-justify: inter-word;
    }
  }

  .media :global(img) {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
  }
</style>
